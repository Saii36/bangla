{
  "manifest_version": 3,
  "name": "Bangla Typing Master",
  "short_name": "Bangla Typing",
  "version": "1.0.0",
  "description": "Dedicated offline Bangla typing tutor supporting Avro Phonetic, Bijoy Classic, Jatiya, and Probhat layouts with grapheme-aware Unicode evaluation, customizable character drills, lesson creator, and progress analytics.",
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "action": {
    "default_title": "Bangla Typing Master",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg",
      "48": "icons/icon.svg"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "storage"
  ],
  "commands": {
    "open-dashboard": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Open Bangla Typing Master full-page practice dashboard"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bangla-typing-master@typingtutor.local",
      "strict_min_version": "109.0"
    }
  }
}
